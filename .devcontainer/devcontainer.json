{
    "name": "Ghost Engine Development",
    "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",
    "forwardPorts": [
        3001
    ],
    "portsAttributes": {
        "3001": {
            "label": "Ghost Engine API",
            "onAutoForward": "notify",
            "visibility": "public"
        }
    },
    "postCreateCommand": "npm install",
    "postStartCommand": "npm run build && npm start",
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode"
            ]
        }
    }
}